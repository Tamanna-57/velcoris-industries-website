{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!_vercel/).*)", "destination": "/index.html" }],
  "images": {
    "sizes": [320, 480, 640, 960, 1280, 1600],
    "qualities": [70],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "^velcorisindustries\\.com$", "pathname": "^/assets/.*$" }
    ]
  },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/((?!assets/|media/|_vercel/).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
